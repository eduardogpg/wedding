<section class="wedding-hero editorial-hero <%= 'with-photo' if wedding.hero_photo.present? %>" id="home">
  <div class="editorial-backdrop">
    <% if wedding.hero_photo.present? %>
      <%= image_tag wedding.hero_photo.variant(resize_to_limit: [2000, 1600]), alt: "#{wedding.couple_names}, celebrando su boda", class: "hero-photo", fetchpriority: "high" %>
    <% else %>
      <span class="editorial-monogram" aria-hidden="true"><%= wedding.initials %></span>
    <% end %>
  </div>
  <div class="hero-copy">
    <span class="eyebrow">EMPIEZA UN CAPÍTULO NUEVO</span>
    <h1><span><%= wedding.partner_one %></span><em>&</em><span><%= wedding.partner_two %></span></h1>
    <p class="hero-headline"><%= wedding.headline.presence || "Nuestra aventura favorita empieza contigo." %></p>
    <a href="#rsvp" class="button wedding-button">Sé parte de nuestra historia <%= icon "arrow", size: 17 %></a>
  </div>
  <div class="editorial-caption"><span>LA BODA DE <%= wedding.initials %></span><p class="hero-date"><%= wedding_date_label(wedding) %></p><a href="#celebration">Descubre el día <span aria-hidden="true">↓</span></a></div>
</section>
