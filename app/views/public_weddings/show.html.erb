<header class="guest-nav"><a href="#home" class="guest-monogram"><%= @wedding.initials %></a><nav aria-label="Navegación de la boda"><% if @wedding.story.present? %><a href="#our-story">Nuestra historia</a><% end %><a href="#celebration">La celebración</a><% if @wedding.gallery_photos.attached? %><a href="#moments">Momentos</a><% end %><% if @wedding.gift_registries.any? %><a href="#regalos">Mesa de regalos</a><% end %><% if @wedding.faqs.visible.exists? %><a href="#preguntas">Preguntas frecuentes</a><% end %><a href="#rsvp" class="guest-rsvp-link">Confirmar <%= icon "arrow", size: 15 %></a></nav></header>
<main>
  <%= render "public_weddings/hero_#{@wedding.page_template}", wedding: @wedding %>
  <section class="invitation-section guest-section"><span class="guest-flower">✳</span><span class="eyebrow">CON AMOR, SIEMPRE</span><h2><%= @wedding.headline.presence || "Nuestro día favorito. Nuestra gente favorita." %></h2><div class="guest-prose"><%= simple_format @wedding.invitation_text %></div><span class="invitation-signature"><%= @wedding.couple_names %></span></section>
  <% if @wedding.story.present? %><section class="story-section guest-section" id="our-story"><div><span class="eyebrow">CÓMO EMPEZÓ TODO</span><h2>Nuestra pequeña<br><em>historia de amor.</em></h2><span class="story-sparkle">✳</span></div><div class="guest-prose"><%= simple_format @wedding.story %></div></section><% end %>
  <section class="celebration-section guest-section" id="celebration"><span class="eyebrow">LOS MOMENTOS QUE VAMOS A COMPARTIR</span><h2>Hagamos de este un gran día.</h2><p class="guest-subtitle"><%= wedding_date_label(@wedding, format: :weekday) %></p><div class="guest-events"><% @wedding.events.each_with_index do |event, index| %><article class="guest-event"><span class="event-index"><%= (index + 1).to_s.rjust(2, '0') %></span><span class="event-time"><%= event_time(event, @wedding) %><% if event.starts_at.in_time_zone(@wedding.timezone).to_date != @wedding.wedding_date %> · <%= event_day(event, @wedding) %><% end %></span><h3><%= event.title %></h3><h4><%= event.venue_name %></h4><p><%= event.address %></p><%= simple_format event.notes, class: "event-note" if event.notes.present? %><% if event.show_map? %><div class="venue-map"><iframe src="<%= event.google_maps_embed_url %>" title="Google Maps: <%= event.venue_name %>" width="600" height="280" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe></div><% end %>
      <%= link_to event.map_link, class: "text-link", target: "_blank", rel: "noopener" do %><%= icon "pin", size: 16 %> Abrir en Google Maps<% end %></article><% end %></div><% if @wedding.events.empty? %><p class="guest-subtitle">Los detalles finos van en camino. Nos hace mucha ilusión celebrar contigo.</p><% else %><p class="timezone-note">Todos los horarios son locales de <%= @wedding.timezone %>.</p><% end %>
    <% if @wedding.dress_code.present? %><div class="dress-code"><%= icon "heart", size: 18 %><span><strong>Una nota sobre la vestimenta</strong><%= @wedding.dress_code %></span></div><% end %>
  </section>
  <% if @wedding.gallery_photos.attached? %><section class="moments-section guest-section" id="moments"><span class="eyebrow">MOMENTOS PEQUEÑOS, AMOR GRANDE</span><h2>Un vistazo de nosotros.</h2><%= render "public_weddings/photo_gallery", wedding: @wedding %></section><% end %>
  <% if @wedding.gift_registries.any? %><section class="registry-section guest-section" id="regalos"><span class="eyebrow">MESA DE REGALOS</span><h2>Si quieres hacernos un regalo.</h2><p class="guest-subtitle">Elige la mesa que te quede más fácil. La lista vive en la tienda.</p><div class="registry-links"><% @wedding.gift_registries.each do |registry| %><%= link_to registry.url, class: "registry-link", target: "_blank", rel: "noopener" do %><strong><%= registry.store_name %></strong><span>Ver mesa <%= icon "external", size: 14 %></span><% end %><% end %></div></section><% end %>
  <%= render "public_weddings/faqs", wedding: @wedding %>
  <section class="rsvp-section guest-section" id="rsvp"><div class="rsvp-intro"><span class="eyebrow">GUARDA UN LUGAR PARA EL AMOR</span><h2>¿Nos<br>acompañas?</h2><p>La celebración no sería la misma sin ti.</p><% if @wedding.rsvp_deadline %><span class="rsvp-deadline">Te pedimos confirmar antes del <%= l(@wedding.rsvp_deadline, format: :long) %>.</span><% end %><span class="guest-flower">✳</span></div><div class="rsvp-form-wrap"><%= render "shared/flashes" %>
    <% if @preview %><div class="preview-rsvp-note"><%= icon "heart", size: 24 %><h3>Cada invitado tiene un lugar aquí.</h3><p>El formulario de confirmación aparece en la página publicada. Las respuestas llegan a tu panel.</p><%= link_to "Volver al detalle de la boda", wedding_path(@wedding), class: "button wedding-button" %></div>
    <% elsif @wedding.accepting_rsvps? %><%= form_with model: @rsvp, url: guest_rsvp_path, class: "stack-form", data: { turbo: false } do |form| %><%= render "shared/errors", record: @rsvp %>
      <div class="field"><%= form.label :guest_name, "Tu nombre completo" %><%= form.text_field :guest_name, required: true, maxlength: 160, autocomplete: "name", placeholder: "Nombre y apellido" %></div>
      <div class="field"><%= form.label :email, "Correo" %><%= form.email_field :email, required: true, maxlength: 254, autocomplete: "email", placeholder: "tu@ejemplo.com" %></div>
      <div class="field-row"><div class="field"><%= form.label :attendance, "¿Vas a asistir?" %><%= form.select :attendance, [["Con mucho gusto", "attending"], ["Con tristeza, no podré", "declined"]], { prompt: "Elige una opción" }, required: true %></div><div class="field"><%= form.label :party_size, "Personas en tu grupo" %><%= form.number_field :party_size, min: 1, max: 10, required: true %></div></div>
      <div class="field"><%= form.label :message, "Una nota (opcional)" %><%= form.text_area :message, rows: 3, maxlength: 1_000, placeholder: "Un deseo, una restricción alimentaria o un poco de cariño…" %></div><%= form.button class: "button wedding-button full-width" do %>Enviar nuestra respuesta <%= icon "heart", size: 17 %><% end %><p class="rsvp-privacy">Tu respuesta se comparte en privado con quien organiza la boda.</p>
    <% end %><% else %><div class="preview-rsvp-note"><span class="guest-flower">✳</span><h3>Gracias por ser parte de nuestra historia.</h3><p>Las confirmaciones ya cerraron. Escribe a la pareja o a quien organiza la boda si necesitas un cambio.</p></div><% end %>
  </div></section>
</main>
<footer class="guest-footer"><span><%= @wedding.couple_names %></span><p><%= wedding_date_label(@wedding) %></p><small>HECHO CON AMOR · BODA</small></footer>
<%= render "public_weddings/mobile_navigation", wedding: @wedding %>
