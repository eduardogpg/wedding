<header class="guest-nav"><a href="#home" class="guest-monogram"><%= @wedding.initials %></a><nav aria-label="Wedding navigation"><% if @wedding.story.present? %><a href="#our-story">Our story</a><% end %><a href="#celebration">The celebration</a><% if @wedding.gallery_photos.attached? %><a href="#moments">Moments</a><% end %><a href="#rsvp" class="guest-rsvp-link">RSVP <%= icon "arrow", size: 15 %></a></nav></header>
<main>
  <section class="wedding-hero <%= 'with-photo' if @wedding.cover_photo.attached? %>" id="home">
    <div class="hero-copy"><span class="eyebrow">JOYFULLY INVITE YOU TO CELEBRATE</span><h1><span><%= @wedding.partner_one %></span><em>&</em><span><%= @wedding.partner_two %></span></h1><div class="hero-rule"></div><p class="hero-date"><%= wedding_date_label(@wedding) %></p><p class="hero-headline"><%= @wedding.headline %></p><a href="#rsvp" class="button wedding-button">Celebrate with us <%= icon "arrow", size: 17 %></a><span class="hero-countdown"><%= days_until(@wedding).positive? ? "#{days_until(@wedding)} DAYS UNTIL FOREVER" : (days_until(@wedding).zero? ? "TODAY IS OUR FOREVER" : "A DAY WE’LL ALWAYS REMEMBER") %></span></div>
    <div class="hero-art"><% if @wedding.cover_photo.attached? %><%= image_tag @wedding.cover_photo.variant(resize_to_limit: [1600, 1800]), alt: "#{@wedding.couple_names}, celebrating their wedding", class: "hero-photo" %><% else %><div class="botanical-arch"><%= render "shared/botanical" %><span><%= @wedding.initials %></span><small>A LOVE IN BLOOM</small></div><% end %></div>
  </section>
  <section class="invitation-section guest-section"><span class="guest-flower">✳</span><span class="eyebrow">WITH LOVE, ALWAYS</span><h2><%= @wedding.headline.presence || "Our favorite day. Our favorite people." %></h2><div class="guest-prose"><%= simple_format @wedding.invitation_text %></div><span class="invitation-signature"><%= @wedding.couple_names %></span></section>
  <% if @wedding.story.present? %><section class="story-section guest-section" id="our-story"><div><span class="eyebrow">HOW IT ALL BEGAN</span><h2>Our little<br><em>love story.</em></h2><span class="story-sparkle">✳</span></div><div class="guest-prose"><%= simple_format @wedding.story %></div></section><% end %>
  <section class="celebration-section guest-section" id="celebration"><span class="eyebrow">THE MOMENTS WE’LL SHARE</span><h2>Let’s make a day of it.</h2><p class="guest-subtitle"><%= wedding_date_label(@wedding, format: "%A, %B %-d, %Y") %></p><div class="guest-events"><% @wedding.events.each_with_index do |event, index| %><article class="guest-event"><span class="event-index"><%= (index + 1).to_s.rjust(2, '0') %></span><span class="event-time"><%= event_time(event, @wedding) %><% if event.starts_at.in_time_zone(@wedding.timezone).to_date != @wedding.wedding_date %> · <%= event.starts_at.in_time_zone(@wedding.timezone).strftime("%b %-d") %><% end %></span><h3><%= event.title %></h3><h4><%= event.venue_name %></h4><p><%= event.address %></p><%= simple_format event.notes, class: "event-note" if event.notes.present? %><% if event.show_map? %><div class="venue-map"><iframe src="<%= event.google_maps_embed_url %>" title="Google Maps: <%= event.venue_name %>" width="600" height="280" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe></div><% end %>
      <%= link_to event.map_link, class: "text-link", target: "_blank", rel: "noopener" do %><%= icon "pin", size: 16 %> Open in Google Maps<% end %></article><% end %></div><% if @wedding.events.empty? %><p class="guest-subtitle">The finer details are coming soon. We can’t wait to celebrate with you.</p><% else %><p class="timezone-note">All times are local to <%= @wedding.timezone %>.</p><% end %>
    <% if @wedding.dress_code.present? %><div class="dress-code"><%= icon "heart", size: 18 %><span><strong>A little note on attire</strong><%= @wedding.dress_code %></span></div><% end %>
  </section>
  <% if @wedding.gallery_photos.attached? %><section class="moments-section guest-section" id="moments"><span class="eyebrow">LITTLE MOMENTS, BIG LOVE</span><h2>A glimpse of us.</h2><%= render "public_weddings/photo_gallery", wedding: @wedding %></section><% end %>
  <section class="rsvp-section guest-section" id="rsvp"><div class="rsvp-intro"><span class="eyebrow">SAVE A SEAT FOR LOVE</span><h2>Will you<br>be joining us?</h2><p>Our celebration wouldn’t be the same without you.</p><% if @wedding.rsvp_deadline %><span class="rsvp-deadline">Kindly reply by <%= @wedding.rsvp_deadline.strftime("%B %-d, %Y") %>.</span><% end %><span class="guest-flower">✳</span></div><div class="rsvp-form-wrap"><%= render "shared/flashes" %>
    <% if @preview %><div class="preview-rsvp-note"><%= icon "heart", size: 24 %><h3>Every guest has a place here.</h3><p>The RSVP form appears here on the published wedding page. Guest responses will arrive in your planner dashboard.</p><%= link_to "Back to wedding details", wedding_path(@wedding), class: "button wedding-button" %></div>
    <% elsif @wedding.accepting_rsvps? %><%= form_with model: @rsvp, url: guest_rsvp_path, class: "stack-form", data: { turbo: false } do |form| %><%= render "shared/errors", record: @rsvp %>
      <div class="field"><%= form.label :guest_name, "Your full name" %><%= form.text_field :guest_name, required: true, maxlength: 160, autocomplete: "name", placeholder: "First and last name" %></div>
      <div class="field"><%= form.label :email, "Email address" %><%= form.email_field :email, required: true, maxlength: 254, autocomplete: "email", placeholder: "you@example.com" %></div>
      <div class="field-row"><div class="field"><%= form.label :attendance, "Will you attend?" %><%= form.select :attendance, [["Joyfully accepts", "attending"], ["Regretfully declines", "declined"]], { prompt: "Please choose" }, required: true %></div><div class="field"><%= form.label :party_size, "Guests in your party" %><%= form.number_field :party_size, min: 1, max: 10, required: true %></div></div>
      <div class="field"><%= form.label :message, "A little note (optional)" %><%= form.text_area :message, rows: 3, maxlength: 1_000, placeholder: "A wish, a dietary request, or just a little love…" %></div><%= form.button class: "button wedding-button full-width" do %>Send our response <%= icon "heart", size: 17 %><% end %><p class="rsvp-privacy">Your response is shared privately with the wedding planner.</p>
    <% end %><% else %><div class="preview-rsvp-note"><span class="guest-flower">✳</span><h3>Thank you for being part of our story.</h3><p>RSVPs are now closed. Please contact the couple or wedding planner for any changes.</p></div><% end %>
  </div></section>
</main>
<footer class="guest-footer"><span><%= @wedding.couple_names %></span><p><%= wedding_date_label(@wedding) %></p><small>MADE WITH LOVE · BODA</small></footer>
<%= render "public_weddings/mobile_navigation", wedding: @wedding %>
