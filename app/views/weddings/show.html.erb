<% content_for :title, "#{@wedding.couple_names} · Boda" %><% content_for :breadcrumb, "Detalle de la boda" %>
<%= link_to "← Todas las bodas", root_path, class: "back-link" %>
<section class="page-heading compact"><div><span class="eyebrow">UNA CELEBRACIÓN HERMOSA</span><h1><%= @wedding.couple_names %></h1><p><%= wedding_date_label(@wedding) %> <span class="inline-dot">·</span> <span class="status-badge inline <%= @wedding.status %>"><span></span><%= wedding_status_label(@wedding) %></span></p></div><div class="button-group"><%= link_to preview_wedding_path(@wedding), class: "button button-secondary" do %><%= icon "external", size: 16 %> Vista previa<% end %><%= link_to preview_wedding_path(@wedding, phase: "live"), class: "button button-secondary" do %><%= icon "heart", size: 16 %> Vista de la fiesta<% end %><%= link_to edit_wedding_path(@wedding), class: "button button-primary" do %><%= icon "edit", size: 16 %> Editar boda<% end %></div></section>
<div class="detail-layout"><div class="detail-main">
  <section class="panel share-panel"><span class="eyebrow">SU RINCÓN EN INTERNET</span><h2>Una página hecha para su día.</h2><p><%= @wedding.published? ? "La invitación ya está publicada. Comparte el enlace y deja que empiece la cuenta regresiva." : "Todo va tomando forma. Revisa la página y publícala cuando esté lista." %></p><div class="share-link"><%= icon "globe", size: 18 %><span><%= public_wedding_url_for(@wedding) %></span><button type="button" class="icon-button" data-controller="copy" data-copy-text-value="<%= public_wedding_url_for(@wedding) %>" data-action="copy#copy"><%= icon "copy", size: 17 %><span class="sr-only" data-copy-label>Copiar enlace</span></button></div>
    <p class="muted"><%= celebration_status(@wedding) %></p>
    <div class="button-group"><% if @wedding.published? %><%= link_to public_wedding_url_for(@wedding), class: "button button-primary", target: "_blank", rel: "noopener" do %>Visitar la página <%= icon "external", size: 16 %><% end %><%= button_to "Ocultar página", unpublish_wedding_path(@wedding), method: :patch, class: "button button-secondary", data: { turbo_confirm: "¿Hacer privada esta página? El enlace dejará de mostrarla." } %><% else %><%= button_to publish_wedding_path(@wedding), method: :patch, class: "button button-primary" do %><%= icon "globe", size: 16 %> Publicar página<% end %><% end %></div>
  </section>
  <section class="panel"><div class="panel-heading"><%= icon "calendar" %><div><h2>El día de un vistazo</h2><p>Horarios en <%= @wedding.timezone %>.</p></div></div><% if @wedding.events.any? %><div class="planner-timeline"><% @wedding.events.each do |event| %><article><time><%= event_time(event, @wedding) %><small><%= event_day(event, @wedding) %></small></time><div><h3><%= event.title %></h3><strong><%= event.venue_name %></strong><p><%= event.address %></p><%= link_to "Ver ubicación ↗", event.map_link, target: "_blank", rel: "noopener", class: "text-link" %></div></article><% end %></div><% else %><p class="muted">Agrega la ceremonia, la recepción u otro momento al programa.</p><%= link_to "Agregar eventos", edit_wedding_path(@wedding, anchor: "the-day"), class: "text-link" %><% end %></section>
  <% if @wedding.gift_registries.any? %><section class="panel"><div class="panel-heading"><div><h2>Mesa de regalos</h2><p>Los invitados abren estas listas en la tienda.</p></div></div><ul class="registry-summary"><% @wedding.gift_registries.each do |registry| %><li><%= link_to registry.store_name, registry.url, target: "_blank", rel: "noopener" %></li><% end %></ul></section><% end %>
</div><aside class="panel response-summary"><span class="stat-icon"><%= icon "users" %></span><span class="eyebrow">LAS PERSONAS QUE LO HACEN ESPECIAL</span><h2>Respuestas</h2><strong class="guest-count"><%= @wedding.confirmed_guests %></strong><p>invitados confirmados</p><dl><div><dt>Van a asistir</dt><dd><%= @wedding.rsvps.attending.count %></dd></div><div><dt>No pueden asistir</dt><dd><%= @wedding.rsvps.declined.count %></dd></div><div><dt>Respuestas en total</dt><dd><%= @wedding.rsvps.count %></dd></div></dl><small><%= @wedding.rsvp_deadline ? "Fecha límite: #{l(@wedding.rsvp_deadline, format: :long)}" : "Sin fecha límite de confirmación" %></small></aside></div>
<section class="panel response-panel"><div class="section-heading"><div><h2>Un lugar en la celebración</h2><p>Todas las respuestas, en un solo sitio.</p></div><%= link_to wedding_rsvps_path(@wedding, format: :csv), class: "button button-secondary" do %><%= icon "download", size: 16 %> Exportar CSV<% end %></div>
  <% if @rsvps.any? %><div class="table-scroll"><table><thead><tr><th>INVITADO</th><th>RESPUESTA</th><th>PERSONAS</th><th>NOTA</th></tr></thead><tbody><% @rsvps.each do |rsvp| %><tr><td><strong><%= rsvp.guest_name %></strong><small><%= rsvp.email %></small></td><td><span class="response-status <%= rsvp.attendance %>"><%= rsvp.attending? ? "Asiste" : "No puede asistir" %></span></td><td><%= rsvp.attending? ? rsvp.party_size : "—" %></td><td class="guest-message"><%= rsvp.message.presence || "—" %></td></tr><% end %></tbody></table></div><% else %><div class="empty-state small"><%= icon "users", size: 28 %><h3>La mejor compañía todavía está por llegar.</h3><p>Las respuestas aparecerán aquí cuando confirmen en la página publicada.</p></div><% end %>
</section>
<section class="panel response-panel"><div class="section-heading"><div><h2>Fotos y buenos deseos de la fiesta</h2><p>Lo que comparten los invitados cuando la página de la fiesta está abierta.</p></div></div>
  <% guest_photos = @wedding.guest_photos.with_attached_images.order(created_at: :desc) %>
  <% wishes = @wedding.guest_wishes.order(created_at: :desc) %>
  <% if guest_photos.any? || wishes.any? %>
    <div class="contribution-list">
      <% guest_photos.each do |guest_photo| %>
        <article>
          <strong><%= guest_photo.guest_name.presence || "Un invitado" %></strong>
          <small><%= l guest_photo.created_at.in_time_zone(@wedding.timezone), format: :short %></small>
          <% if guest_photo.caption.present? %><p><%= guest_photo.caption %></p><% end %>
          <div class="guest-photo-strip"><% guest_photo.images.each do |image| %><%= image_tag image.variant(resize_to_limit: [320, 320]), alt: guest_photo.caption.presence || "Foto compartida en la boda" %><% end %></div>
        </article>
      <% end %>
      <% wishes.each do |wish| %>
        <article>
          <strong><%= wish.guest_name.presence || "Un invitado" %></strong>
          <small><%= l wish.created_at.in_time_zone(@wedding.timezone), format: :short %></small>
          <p class="guest-message"><%= wish.body %></p>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state small"><%= icon "heart", size: 28 %><h3>La página de la fiesta ya los espera.</h3><p>Las fotos y los buenos deseos aparecerán aquí cuando empiece la celebración.</p></div>
  <% end %>
</section>
<div class="danger-zone"><span>Elimina esta boda con sus fotos, eventos, respuestas y recuerdos de la fiesta.</span><%= button_to "Eliminar boda", wedding_path(@wedding), method: :delete, class: "text-button danger", data: { turbo_confirm: "¿Eliminar para siempre esta boda, sus fotos y todas las respuestas? No se puede deshacer." } %></div>
