<% content_for :title, "#{@wedding.couple_names} · Boda" %><% content_for :breadcrumb, "Wedding details" %>
<%= link_to "← All weddings", root_path, class: "back-link" %>
<section class="page-heading compact"><div><span class="eyebrow">ONE BEAUTIFUL CELEBRATION</span><h1><%= @wedding.couple_names %></h1><p><%= wedding_date_label(@wedding) %> <span class="inline-dot">·</span> <span class="status-badge inline <%= @wedding.status %>"><span></span><%= @wedding.status.capitalize %></span></p></div><div class="button-group"><%= link_to preview_wedding_path(@wedding), class: "button button-secondary" do %><%= icon "external", size: 16 %> Preview<% end %><%= link_to preview_wedding_path(@wedding, phase: "live"), class: "button button-secondary" do %><%= icon "heart", size: 16 %> Preview live event<% end %><%= link_to edit_wedding_path(@wedding), class: "button button-primary" do %><%= icon "edit", size: 16 %> Edit wedding<% end %></div></section>
<div class="detail-layout"><div class="detail-main">
  <section class="panel share-panel"><span class="eyebrow">THEIR LITTLE CORNER OF THE INTERNET</span><h2>A page made for their day.</h2><p><%= @wedding.published? ? "The invitation is live. Share the link and let the countdown begin." : "Everything is taking shape. Preview the page and publish when you’re ready." %></p><div class="share-link"><%= icon "globe", size: 18 %><span><%= public_wedding_url_for(@wedding) %></span><button type="button" class="icon-button" data-controller="copy" data-copy-text-value="<%= public_wedding_url_for(@wedding) %>" data-action="copy#copy"><%= icon "copy", size: 17 %><span class="sr-only" data-copy-label>Copy wedding link</span></button></div>
    <div class="button-group"><% if @wedding.published? %><%= link_to public_wedding_url_for(@wedding), class: "button button-primary", target: "_blank", rel: "noopener" do %>Visit live page <%= icon "external", size: 16 %><% end %><%= button_to "Unpublish page", unpublish_wedding_path(@wedding), method: :patch, class: "button button-secondary", data: { turbo_confirm: "Make this wedding page private? The shared link will stop showing the page." } %><% else %><%= button_to publish_wedding_path(@wedding), method: :patch, class: "button button-primary" do %><%= icon "globe", size: 16 %> Publish wedding page<% end %><% end %></div>
  </section>
  <section class="panel"><div class="panel-heading"><%= icon "calendar" %><div><h2>The day at a glance</h2><p>Times shown in <%= @wedding.timezone %>.</p></div></div><% if @wedding.events.any? %><div class="planner-timeline"><% @wedding.events.each do |event| %><article><time><%= event_time(event, @wedding) %><small><%= event.starts_at.in_time_zone(@wedding.timezone).strftime("%b %-d") %></small></time><div><h3><%= event.title %></h3><strong><%= event.venue_name %></strong><p><%= event.address %></p><%= link_to "View location ↗", event.map_link, target: "_blank", rel: "noopener", class: "text-link" %></div></article><% end %></div><% else %><p class="muted">Add a ceremony, reception, or another moment to the schedule.</p><%= link_to "Add wedding events", edit_wedding_path(@wedding, anchor: "the-day"), class: "text-link" %><% end %></section>
</div><aside class="panel response-summary"><span class="stat-icon"><%= icon "users" %></span><span class="eyebrow">THE PEOPLE WHO MAKE IT SPECIAL</span><h2>Guest responses</h2><strong class="guest-count"><%= @wedding.confirmed_guests %></strong><p>guests confirmed</p><dl><div><dt>Attending responses</dt><dd><%= @wedding.rsvps.attending.count %></dd></div><div><dt>Unable to attend</dt><dd><%= @wedding.rsvps.declined.count %></dd></div><div><dt>Total responses</dt><dd><%= @wedding.rsvps.count %></dd></div></dl><small><%= @wedding.rsvp_deadline ? "RSVP deadline: #{l(@wedding.rsvp_deadline, format: :long)}" : "No RSVP deadline set" %></small></aside></div>
<section class="panel response-panel"><div class="section-heading"><div><h2>A seat at the celebration</h2><p>All guest responses, in one place.</p></div><%= link_to wedding_rsvps_path(@wedding, format: :csv), class: "button button-secondary" do %><%= icon "download", size: 16 %> Export CSV<% end %></div>
  <% if @rsvps.any? %><div class="table-scroll"><table><thead><tr><th>GUEST</th><th>RESPONSE</th><th>PARTY SIZE</th><th>NOTE</th></tr></thead><tbody><% @rsvps.each do |rsvp| %><tr><td><strong><%= rsvp.guest_name %></strong><small><%= rsvp.email %></small></td><td><span class="response-status <%= rsvp.attendance %>"><%= rsvp.attending? ? "Attending" : "Unable to attend" %></span></td><td><%= rsvp.attending? ? rsvp.party_size : "—" %></td><td class="guest-message"><%= rsvp.message.presence || "—" %></td></tr><% end %></tbody></table></div><% else %><div class="empty-state small"><%= icon "users", size: 28 %><h3>The best company is yet to come.</h3><p>Guest responses will appear here once they RSVP on the published page.</p></div><% end %>
</section>
<div class="danger-zone"><span>Remove this wedding and all of its photos, events, and guest responses.</span><%= button_to "Delete wedding", wedding_path(@wedding), method: :delete, class: "text-button danger", data: { turbo_confirm: "Permanently delete this wedding, its photos, and every guest response? This cannot be undone." } %></div>
