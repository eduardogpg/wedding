<% content_for :title, "Tus bodas · Boda" %>
<section class="page-heading"><div><span class="eyebrow">UN POCO DE PLANEACIÓN. MUCHO AMOR.</span><h1>Los días hermosos empiezan aquí<span class="sage-text">.</span></h1><p>Cada pareja, cada detalle, cada felices para siempre.</p></div><%= link_to new_wedding_path, class: "button button-primary" do %><%= icon "plus", size: 18 %> Crear una boda<% end %></section>
<div class="stats-grid">
  <div class="stat-card"><span class="stat-icon"><%= icon "heart" %></span><div><span class="stat-label">BODAS EN TOTAL</span><strong><%= @total.to_s.rjust(2, '0') %></strong><small>Historias de amor a tu cuidado</small></div></div>
  <div class="stat-card"><span class="stat-icon blue"><%= icon "globe" %></span><div><span class="stat-label">PÁGINAS PUBLICADAS</span><strong><%= @published.to_s.rjust(2, '0') %></strong><small>Listas para compartir</small></div></div>
  <div class="stat-card"><span class="stat-icon peach"><%= icon "calendar" %></span><div><span class="stat-label">BODAS PRÓXIMAS</span><strong><%= @upcoming.to_s.rjust(2, '0') %></strong><small>Cosas lindas en el horizonte</small></div></div>
</div>
<% if @next_wedding %>
  <section class="next-wedding"><div class="next-copy"><span class="eyebrow">LA SIGUIENTE EN TU CALENDARIO</span><h2><%= @next_wedding.couple_names %></h2><p><%= wedding_date_label(@next_wedding) %><span>·</span><%= days_until_phrase(@next_wedding) %></p><%= link_to wedding_path(@next_wedding), class: "text-link" do %>Hagamos de este un día hermoso <%= icon "arrow", size: 17 %><% end %></div><div class="next-art"><%= render "shared/botanical" %><span class="next-monogram"><%= @next_wedding.initials %></span></div></section>
<% end %>
<section id="wedding-list" class="wedding-list"><div class="section-heading"><div><h2>Tus bodas <span class="count-pill"><%= @total %></span></h2><p>Un hogar para cada celebración que estás preparando.</p></div></div>
  <div class="list-toolbar"><nav class="filter-tabs" aria-label="Estado de la boda"><% { "all" => "Todas", "published" => "Publicadas", "draft" => "Borradores" }.each do |value, label| %><%= link_to label, root_path(status: value, q: @query, anchor: "wedding-list"), class: "filter-tab #{'selected' if @filter == value}", aria: { current: @filter == value ? "page" : nil } %><% end %></nav>
    <%= form_with url: root_path(anchor: "wedding-list"), method: :get, class: "search-form" do |form| %><%= form.hidden_field :status, value: @filter %><%= form.label :q, "Buscar bodas", class: "sr-only" %><%= icon "search", size: 17 %><%= form.search_field :q, value: @query, placeholder: "Busca por pareja o dirección…" %><%= form.submit "Buscar", class: "search-submit" %><% end %>
  </div>
  <% if @weddings.any? %><div class="wedding-grid"><% @weddings.each do |wedding| %><article class="wedding-card theme-<%= wedding.theme %>">
    <%= link_to wedding_path(wedding), class: "card-cover", aria: { label: "Administrar #{wedding.couple_names}" } do %>
      <% if wedding.hero_photo %><%= image_tag wedding.hero_photo.variant(resize_to_limit: [900, 600]), alt: wedding.couple_names, loading: "lazy" %><% else %><%= render "shared/botanical" %><span class="cover-initials"><%= wedding.initials %></span><% end %>
      <span class="status-badge <%= wedding.status %>"><span></span><%= wedding_status_label(wedding) %></span>
    <% end %>
    <div class="card-body"><span class="card-date"><%= icon "calendar", size: 14 %><%= wedding_date_label(wedding) %></span><h3><%= link_to wedding.couple_names, wedding_path(wedding) %></h3><p class="card-domain"><%= wedding.subdomain %>.<%= Rails.configuration.x.app_domain %></p><div class="card-actions"><%= link_to "Administrar boda", wedding_path(wedding), class: "text-link" %><%= link_to preview_wedding_path(wedding), class: "card-preview", title: "Vista previa de la página" do %><%= icon "external", size: 17 %><span class="sr-only">Vista previa de <%= wedding.couple_names %></span><% end %></div></div>
  </article><% end %>
  <%= link_to new_wedding_path, class: "new-wedding-card" do %><span><%= icon "plus", size: 25 %></span><h3>Un nuevo comienzo</h3><p>Dale a la siguiente historia de amor<br>un lugar para crecer.</p><strong>Crear una boda <%= icon "arrow", size: 16 %></strong><% end %></div>
  <% else %><div class="empty-state"><span>✳</span><h3><%= @query.present? || @filter != "all" ? "No encontramos bodas" : "Tu siguiente historia de amor empieza aquí" %></h3><p><%= @query.present? || @filter != "all" ? "Prueba otra búsqueda o mira todas las bodas." : "Crea tu primera boda y dale a la celebración un hogar hermoso." %></p><%= link_to "Ver todas las bodas", root_path, class: "button button-secondary" if @query.present? || @filter != "all" %><%= link_to "Crear una boda", new_wedding_path, class: "button button-primary" if @total.zero? %></div><% end %>
</section>
