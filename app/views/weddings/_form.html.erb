<%= form_with model: wedding, class: "wedding-form", data: { controller: "wedding-form", turbo: false } do |form| %>
  <%= render "shared/errors", record: wedding %>
  <div class="editor-layout"><nav class="editor-nav" aria-label="Wedding editor sections"><a href="#the-couple">01 <span>The couple</span></a><a href="#their-story">02 <span>Invitation & story</span></a><a href="#the-day">03 <span>The day</span></a><a href="#the-look">04 <span>Photos & style</span></a><a href="#guest-details">05 <span>Guest details</span></a></nav>
  <div class="editor-sections">
    <section class="panel form-panel" id="the-couple"><div class="panel-heading"><span class="section-number">01</span><div><h2>The couple</h2><p>Let’s start with the two people at the heart of it all.</p></div></div>
      <div class="field-row"><div class="field"><%= form.label :partner_one, "First partner’s name" %><%= form.text_field :partner_one, required: true, maxlength: 80, placeholder: "Eduardo", data: { action: "input->wedding-form#suggestSubdomain", wedding_form_target: "partnerOne" } %></div><div class="field"><%= form.label :partner_two, "Second partner’s name" %><%= form.text_field :partner_two, required: true, maxlength: 80, placeholder: "Raquel", data: { action: "input->wedding-form#suggestSubdomain", wedding_form_target: "partnerTwo" } %></div></div>
      <div class="field-row"><div class="field"><%= form.label :wedding_date %><%= form.date_field :wedding_date, required: true %></div><div class="field"><%= form.label :timezone, "Wedding time zone" %><%= form.time_zone_select :timezone, ActiveSupport::TimeZone.us_zones, default: "Mexico City" %><small>All event times use this time zone.</small></div></div>
      <div class="field"><%= form.label :subdomain, "Wedding page address" %><div class="input-suffix"><%= form.text_field :subdomain, required: true, minlength: 3, maxlength: 63, pattern: "[a-z0-9]+(-[a-z0-9]+)*", placeholder: "eduardo-and-raquel", data: { wedding_form_target: "subdomain", action: "input->wedding-form#markSubdomainEdited", auto_suggest: wedding.new_record? && wedding.subdomain.blank? } %><span>.<%= Rails.configuration.x.app_domain %></span></div><small>A unique address for this celebration. Changing it will change the shared link.</small></div>
    </section>
    <section class="panel form-panel" id="their-story"><div class="panel-heading"><span class="section-number">02</span><div><h2>Words from the heart</h2><p>An invitation that feels like them.</p></div></div>
      <div class="field"><%= form.label :headline, "A little headline" %><%= form.text_field :headline, maxlength: 150, placeholder: "Together is a beautiful place to be." %></div>
      <div class="field"><%= form.label :invitation_text, "Invitation message" %><%= form.text_area :invitation_text, required: true, rows: 4, maxlength: 10_000 %></div>
      <div class="field"><%= form.label :story, "Their story (optional)" %><%= form.text_area :story, rows: 5, maxlength: 10_000, placeholder: "How it all began…" %></div>
    </section>
    <section class="panel form-panel" id="the-day"><div class="panel-heading"><span class="section-number">03</span><div><h2>A day to remember</h2><p>The ceremony, the first dance, and everything in between.</p></div></div>
      <div data-wedding-form-target="events"><%= form.fields_for :events do |event_form| %><%= render "event_fields", form: event_form, wedding: wedding %><% end %></div>
      <template data-wedding-form-target="eventTemplate"><%= form.fields_for :events, Event.new, child_index: "NEW_EVENT" do |event_form| %><%= render "event_fields", form: event_form, wedding: wedding %><% end %></template>
      <button type="button" class="button button-secondary" data-action="wedding-form#addEvent"><%= icon "plus", size: 16 %> Add an event</button>
    </section>
    <section class="panel form-panel" id="the-look"><div class="panel-heading"><span class="section-number">04</span><div><h2>Make it their own</h2><p>Personal touches for a page that feels just right.</p></div></div>
      <fieldset class="theme-picker"><legend>Page palette</legend><% Wedding::THEMES.each do |value, label| %><label class="theme-option theme-<%= value %>"><%= form.radio_button :theme, value %><span class="theme-swatch"></span><span><%= label %></span></label><% end %></fieldset>
      <div class="field upload-field"><%= form.label :cover_photo, "Cover photo" %><% if wedding.cover_photo.attached? && wedding.cover_photo.persisted? %><div class="current-cover"><%= image_tag wedding.cover_photo.variant(resize_to_limit: [600, 350]), alt: "Current cover" %><label class="checkbox-label"><%= check_box_tag "wedding[remove_cover_photo]", "1" %> Remove current cover</label></div><% end %><%= form.file_field :cover_photo, accept: "image/jpeg,image/png,image/webp" %><small>JPEG, PNG, or WebP · Up to 10 MB. A landscape photo works beautifully.</small></div>
      <div class="field upload-field"><%= form.label :gallery_photos, "Photo gallery" %><%= form.file_field :gallery_photos, multiple: true, accept: "image/jpeg,image/png,image/webp", include_hidden: false %><small>Add up to 20 photos in total, up to 10 MB each. New photos are added to the gallery.</small></div>
      <% if wedding.gallery_photos.attached? %><div class="photo-edit-grid"><% wedding.gallery_photos.each do |photo| %><% if photo.persisted? %><label><%= image_tag photo.variant(resize_to_limit: [300, 300]), alt: "Gallery photo", loading: "lazy" %><span><%= check_box_tag "wedding[remove_gallery_photo_ids][]", photo.id %> Remove photo</span></label><% end %><% end %></div><% end %>
    </section>
    <section class="panel form-panel" id="guest-details"><div class="panel-heading"><span class="section-number">05</span><div><h2>A note for the guests</h2><p>A few helpful details before the big day.</p></div></div>
      <div class="field-row"><div class="field"><%= form.label :dress_code, "Dress code (optional)" %><%= form.text_field :dress_code, maxlength: 160, placeholder: "Garden formal · A little color encouraged" %></div><div class="field"><%= form.label :rsvp_deadline, "RSVP deadline (optional)" %><%= form.date_field :rsvp_deadline %><small>Responses close after this date, or after the wedding.</small></div></div>
    </section>
    <div class="form-actions"><%= link_to "Cancel", wedding.persisted? ? wedding_path(wedding) : root_path, class: "button button-secondary" %><%= form.button class: "button button-primary" do %><%= icon "check", size: 17 %><%= wedding.new_record? ? "Create wedding" : "Save wedding" %><% end %></div>
  </div></div>
<% end %>
