<%= form_with model: wedding, html: { multipart: true }, class: "wedding-form", data: { controller: "wedding-form", turbo: false } do |form| %>
  <%= render "shared/errors", record: wedding %>
  <div class="editor-layout"><nav class="editor-nav" aria-label="Secciones del editor"><a href="#the-couple">01 <span>La pareja</span></a><a href="#their-story">02 <span>Invitación e historia</span></a><a href="#the-day">03 <span>El día</span></a><a href="#the-look">04 <span>Fotos y estilo</span></a><a href="#guest-details">05 <span>Para los invitados</span></a></nav>
  <div class="editor-sections">
    <section class="panel form-panel" id="the-couple"><div class="panel-heading"><span class="section-number">01</span><div><h2>La pareja</h2><p>Empecemos por las dos personas en el centro de todo.</p></div></div>
      <div class="field-row"><div class="field"><%= form.label :partner_one, "Nombre de la primera persona" %><%= form.text_field :partner_one, required: true, maxlength: 80, placeholder: "Eduardo", data: { action: "input->wedding-form#suggestSubdomain", wedding_form_target: "partnerOne" } %></div><div class="field"><%= form.label :partner_two, "Nombre de la segunda persona" %><%= form.text_field :partner_two, required: true, maxlength: 80, placeholder: "Raquel", data: { action: "input->wedding-form#suggestSubdomain", wedding_form_target: "partnerTwo" } %></div></div>
      <div class="field-row"><div class="field"><%= form.label :wedding_date, "Fecha de la boda" %><%= form.date_field :wedding_date, required: true %></div><div class="field"><%= form.label :timezone, "Zona horaria de la boda" %><%= form.time_zone_select :timezone, ActiveSupport::TimeZone.us_zones, default: "Mexico City" %><small>Todos los horarios usan esta zona.</small></div></div>
      <div class="field"><%= form.label :subdomain, "Dirección de la página" %><div class="input-suffix"><%= form.text_field :subdomain, required: true, minlength: 3, maxlength: 63, pattern: "[a-z0-9]+(-[a-z0-9]+)*", placeholder: "eduardo-y-raquel", data: { wedding_form_target: "subdomain", action: "input->wedding-form#markSubdomainEdited", auto_suggest: wedding.new_record? && wedding.subdomain.blank? } %><span>.<%= Rails.configuration.x.app_domain %></span></div><small>Una dirección única para esta celebración. Si la cambias, cambia el enlace que compartes.</small></div>
    </section>
    <section class="panel form-panel" id="their-story"><div class="panel-heading"><span class="section-number">02</span><div><h2>Palabras del corazón</h2><p>Una invitación que se sienta como ellos.</p></div></div>
      <div class="field"><%= form.label :headline, "Un pequeño titular" %><%= form.text_field :headline, maxlength: 150, placeholder: "Juntos es un lugar hermoso." %></div>
      <div class="field"><%= form.label :invitation_text, "Mensaje de invitación" %><%= form.text_area :invitation_text, required: true, rows: 4, maxlength: 10_000 %></div>
      <div class="field"><%= form.label :story, "Su historia (opcional)" %><%= form.text_area :story, rows: 5, maxlength: 10_000, placeholder: "Cómo empezó todo…" %></div>
    </section>
    <section class="panel form-panel" id="the-day"><div class="panel-heading"><span class="section-number">03</span><div><h2>Un día para recordar</h2><p>Agrega la ceremonia, la recepción o las dos. Con un evento basta.</p></div></div>
      <div class="field-row"><div class="field"><%= form.label :celebration_starts_at, "Abrir la página de la fiesta" %><%= form.datetime_local_field :celebration_starts_at, value: wedding.celebration_starts_at&.in_time_zone(wedding.timezone)&.strftime("%Y-%m-%dT%H:%M") %><small>A esta hora el enlace público deja la invitación y muestra las fotos y los buenos deseos. Si lo dejas vacío, cambia cuando empiece el primer evento.</small></div><div class="field"><%= form.label :landing_mode, "Si la fiesta empieza antes o después" %><%= form.select :landing_mode, [["Seguir la hora de inicio", "automatic"], ["Seguir mostrando la invitación", "invitation"], ["Mostrar fotos y buenos deseos ahora", "live"]] %><small>La página de la fiesta se queda abierta después de empezar. Vuelve a elegir la invitación cuando quieras la página original.</small></div></div>
      <div data-wedding-form-target="events"><%= form.fields_for :events do |event_form| %><%= render "event_fields", form: event_form, wedding: wedding %><% end %></div>
      <template data-wedding-form-target="eventTemplate"><%= form.fields_for :events, Event.new, child_index: "NEW_EVENT" do |event_form| %><%= render "event_fields", form: event_form, wedding: wedding %><% end %></template>
      <button type="button" class="button button-secondary" data-action="wedding-form#addEvent"><%= icon "plus", size: 16 %> Agregar un evento</button>
    </section>
    <section class="panel form-panel" id="the-look"><div class="panel-heading"><span class="section-number">04</span><div><h2>Que se sienta suyo</h2><p>Detalles para una página que les quede justo.</p></div></div>
      <%= render "template_picker", form: form %>
      <fieldset class="theme-picker"><legend>Paleta de la página</legend><% Wedding::THEMES.each do |value, label| %><label class="theme-option theme-<%= value %>"><%= form.radio_button :theme, value %><span class="theme-swatch"></span><span><%= label %></span></label><% end %></fieldset>
      <%= render "photo_fields", form: form, wedding: wedding %>
    </section>
    <section class="panel form-panel" id="guest-details"><div class="panel-heading"><span class="section-number">05</span><div><h2>Una nota para los invitados</h2><p>Unos detalles útiles antes del gran día.</p></div></div>
      <div class="field-row"><div class="field"><%= form.label :dress_code, "Código de vestimenta (opcional)" %><%= form.text_field :dress_code, maxlength: 160, placeholder: "Formal de jardín · Un poco de color es bienvenido" %></div><div class="field"><%= form.label :rsvp_deadline, "Fecha límite de confirmación (opcional)" %><%= form.date_field :rsvp_deadline %><small>Las respuestas se cierran después de esta fecha, o después de la boda.</small></div></div>
      <div class="schedule-editor">
        <div class="schedule-heading"><h3>Mesa de regalos</h3><p>Pega el enlace de Liverpool, El Palacio de Hierro u otra tienda. La lista se queda en la tienda; aquí solo compartes el acceso.</p></div>
        <div data-wedding-form-target="registries">
          <%= form.fields_for :gift_registries do |registry_form| %><%= render "registry_fields", form: registry_form %><% end %>
        </div>
        <button type="button" class="button button-secondary" data-action="wedding-form#addRegistry">Agregar mesa de regalos</button>
        <template data-wedding-form-target="registryTemplate"><%= form.fields_for :gift_registries, GiftRegistry.new, child_index: "NEW_REGISTRY" do |registry_form| %><%= render "registry_fields", form: registry_form %><% end %></template>
      </div>
      <div class="faq-editor">
        <h3>Preguntas frecuentes (opcional)</h3>
        <p>Agrega solo las que necesites. Puedes ocultar una pregunta sin borrarla; si no hay preguntas visibles, esta sección no aparece en la invitación.</p>
        <p>Ideas: acompañantes, niños, estacionamiento, transporte, hospedaje y restricciones alimentarias.</p>
        <div data-wedding-form-target="faqs"><%= form.fields_for :faqs do |faq_form| %><%= render "faq_fields", form: faq_form %><% end %></div>
        <button type="button" class="button button-secondary" data-action="wedding-form#addFaq">Agregar pregunta</button>
        <template data-wedding-form-target="faqTemplate"><%= form.fields_for :faqs, WeddingFaq.new, child_index: "NEW_FAQ" do |faq_form| %><%= render "faq_fields", form: faq_form %><% end %></template>
      </div>
    </section>
    <p class="save-preview-hint">Guarda los cambios para actualizar las fotos, la plantilla y la invitación.</p>
    <div class="form-actions"><%= link_to "Cancelar", wedding.persisted? ? wedding_path(wedding) : root_path, class: "button button-secondary" %><%= form.button "Guardar y ver", name: "preview", value: "1", class: "button button-secondary" %><%= form.button class: "button button-primary" do %><%= icon "check", size: 17 %><%= wedding.new_record? ? "Crear boda" : "Guardar boda" %><% end %></div>
  </div></div>
<% end %>
